rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 💡 系統管理員動態判斷函式：
    // 凡登記於 system_admins 雲端動態集合中的授權信箱即具備管理員權限
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/system_admins/$(request.auth.token.email.lower()))
      );
    }

    // 👑 系統管理員動態授權清單（支援在網頁系統設定中增刪，無需重新部署 Rules）
    match /system_admins/{adminEmail} {
      // 任何已登入使用者皆可讀取管理員清單以確認自身身分與同步權限
      allow read: if request.auth != null;
      // 只有現任管理員（或最高超級管理員）有權新增、更新或移除管理員
      allow create, update, delete: if isAdmin();
    }

    // 評量測驗歷史紀錄
    match /assessment_records/{recordId} {
      // 任何登入的 Google 使用者皆可建立自己的測驗成果
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // 使用者可讀取自己的學習紀錄；管理者可查看全體學員紀錄
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // 允許使用者刪除自己的測驗紀錄，管理者亦可刪除
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // 保持評量客觀歷史性，不允許竄改修改紀錄內容
      allow update: if false;
    }

    // 使用者個人資料 (同步角色等級、EXP、星幣與錯題書)
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // 管理者可讀取學員角色資料
      allow read: if isAdmin();
    }

    // RAG 自訂考題庫 (學生拍照分析上傳與全域雲端共享)
    match /rag_custom_questions/{questionId} {
      // 全體學員與訪客皆可讀取雲端題庫，供 AI 弱點出題與段考特訓使用
      allow read: if true;

      // 登入學員皆可上傳考題至雲端知識庫
      allow create: if request.auth != null &&
        request.resource.data.stem is string &&
        request.resource.data.stem.size() > 0;

      // 上傳者本人或系統管理員可更新或刪除考題
      allow update, delete: if request.auth != null && (
        resource.data.uploaderUid == request.auth.uid ||
        isAdmin()
      );
    }

    // 篩選維度點選日誌 (學年、學期、段考次數統計)
    match /selection_logs/{logId} {
      // 允許學員或訪客建立點選紀錄（寫入時驗證必要欄位型態）
      allow create: if request.resource.data.filterType is string &&
        request.resource.data.value is string &&
        request.resource.data.label is string;

      // 僅系統管理者有權讀取點選統計日誌
      allow read: if isAdmin();

      // 保持日誌客觀歷史性，不允許竄改或刪除
      allow update, delete: if false;
    }
  }
}
